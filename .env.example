# ============================================================
# CORE
# ============================================================
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Authentication (admin sessions) — long random string, min 32 chars
AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Admin bootstrap
ADMIN_EMAIL=admin@rentacar.pk
ADMIN_PASSWORD=Admin@12345

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================

# ============================================================
# OTP DELIVERY — EMAIL (choose ONE of the two options below)
# ============================================================

# --- Option A: Resend (recommended, simplest) ---
# Create an API key at https://resend.com/api-keys
# You MUST verify your sending domain at https://resend.com/domains
# EMAIL_FROM must use a domain you have verified with the provider.
RESEND_API_KEY=
EMAIL_FROM="Rent A Car <no-reply@yourdomain.com>"

# --- Option B: SMTP (Gmail App Password, SendGrid, AWS SES, Mailgun...) ---
# Gmail: enable 2FA, then create an App Password at
#   https://myaccount.google.com/apppasswords
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional reply-to address
EMAIL_REPLY_TO=

# ============================================================
# OTP DELIVERY — SMS (choose ONE of the two options below)
# ============================================================

# --- Option A: Twilio ---
# From https://console.twilio.com — Account SID, Auth Token, and a purchased
# SMS-capable sender number in E.164 (e.g. +14155552671).
# NOTE: Pakistani (+92) destination numbers require a provider/plan that
# supports the PK corridor — verify this in your Twilio console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Optional: override the Twilio API base (regional endpoints / testing)
TWILIO_API_BASE=

# --- Option B: Vonage ---
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=

# ============================================================
# OTP BEHAVIOUR
# ============================================================
# Dev-only: set to 1 ONLY for local testing. NEVER set in production.
OTP_EXPOSE_DEV=

# ============================================================
# OPTIONAL PLATFORM INTEGRATIONS
# ============================================================
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
PICKUP_LAT=31.5204
PICKUP_LNG=74.3587
AI_API_KEY=
TRACKING_RETENTION_DAYS=7
